@using Microsoft.AspNetCore.Components.Authorization
@using LinuxTrainer.Components.Auth

<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(LinuxTrainer.Client._Imports).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData"
                            DefaultLayout="typeof(LinuxTrainer.Components.Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
