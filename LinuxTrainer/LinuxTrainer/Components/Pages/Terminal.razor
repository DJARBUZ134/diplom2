@page "/profile/terminal"
@attribute [Authorize]
@rendermode InteractiveServer
@layout LinuxTrainer.Components.Layout.MainLayout
@using System.Security.Claims
@using LinuxTrainer.Services
@inject ITerminalService Term
@inject AuthenticationStateProvider Auth

<PageTitle>Терминал</PageTitle>

<MudContainer Class="mt-4" MaxWidth="MaxWidth.Large">
    <div class="d-flex align-center mb-3">
        <MudText Typo="Typo.h5">Ubuntu 22.04 — сессия</MudText>
        <MudSpacer />
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
            @login
        </MudChip>
        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="Reset"
                   Class="ml-2">
            Сбросить
        </MudButton>
    </div>

    <div class="terminal" @onclick="FocusInput">
        <div class="terminal-header">
            <span class="dot dot-r"></span>
            <span class="dot dot-y"></span>
            <span class="dot dot-g"></span>
            <span class="terminal-title">@login@@ubuntu: @prompt</span>
        </div>
        <div class="terminal-body">
            @foreach (var line in output)
            {
                <div class="line @(line.Kind)">@line.Text</div>
            }
            <div class="line input-line">
                <span class="prompt">@prompt</span>
                <input class="cmd-input"
                       @ref="inputRef"
                       @bind="current"
                       @bind:event="oninput"
                       @onkeydown="OnKey"
                       spellcheck="false"
                       autocomplete="off" />
            </div>
        </div>
    </div>
</MudContainer>

@code {
    private record Line(string Text, string Kind);

    private List<Line> output = new();
    private List<string> history = new();
    private int historyIndex = -1;
    private string current = "";
    private string prompt = "$ ";
    private string login = "";
    private string role = "";
    private int userId;
    private ElementReference inputRef;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        login = state.User.Identity?.Name ?? "user";
        role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        if (int.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            userId = id;

        var view = await Term.LoadAsync(userId, login, role);
        prompt = view.Prompt;
        history = view.History.ToList();
        output.Add(new Line($"Добро пожаловать в Ubuntu 22.04.3 LTS — сессия {login}", "sys"));
        output.Add(new Line("Введите 'help' для списка команд, 'man <команда>' для справки.", "sys"));
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Execute();
        }
        else if (e.Key == "ArrowUp")
        {
            if (history.Count == 0) return;
            historyIndex = historyIndex < 0 ? history.Count - 1 : Math.Max(0, historyIndex - 1);
            current = history[historyIndex];
        }
        else if (e.Key == "ArrowDown")
        {
            if (history.Count == 0 || historyIndex < 0) return;
            historyIndex++;
            if (historyIndex >= history.Count) { historyIndex = -1; current = ""; }
            else current = history[historyIndex];
        }
    }

    private async Task Execute()
    {
        var cmd = current;
        current = "";
        historyIndex = -1;
        output.Add(new Line(prompt + cmd, "cmd"));

        if (string.IsNullOrWhiteSpace(cmd)) return;

        var (text, view) = await Term.ExecuteAsync(userId, login, role, cmd);
        prompt = view.Prompt;
        history = view.History.ToList();

        if (text == "CLEAR")
        {
            output.Clear();
        }
        else if (cmd.Trim() == "history")
        {
            for (int i = 0; i < history.Count; i++)
                output.Add(new Line($"  {i + 1}  {history[i]}", "out"));
        }
        else if (!string.IsNullOrEmpty(text))
        {
            foreach (var ln in text.Split('\n'))
                output.Add(new Line(ln.TrimEnd('\r'), "out"));
        }

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await inputRef.FocusAsync();
    }

    private async Task FocusInput() => await inputRef.FocusAsync();

    private async Task Reset()
    {
        await Term.ResetAsync(userId);
        var view = await Term.LoadAsync(userId, login, role);
        prompt = view.Prompt;
        history = view.History.ToList();
        output.Clear();
        output.Add(new Line("Сессия сброшена.", "sys"));
    }
}
