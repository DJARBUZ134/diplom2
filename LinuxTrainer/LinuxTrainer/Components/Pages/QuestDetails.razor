@page "/profile/quests/{QuestId:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@layout LinuxTrainer.Components.Layout.MainLayout
@using System.Security.Claims
@using LinuxTrainer.Data.Entities
@using LinuxTrainer.Services
@using Microsoft.AspNetCore.Components.Web
@inject IProgressService Progress
@inject ITerminalService Term
@inject AuthenticationStateProvider Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(details?.Name ?? "Задание")</PageTitle>

@if (details is null)
{
    <MudContainer Class="mt-4">
        <MudText>Задание не найдено.</MudText>
        <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/profile/quests"))">К списку</MudButton>
    </MudContainer>
}
else if (details.Status == QuestStatus.Locked)
{
    <MudContainer Class="mt-4">
        <MudAlert Severity="Severity.Warning">
            Это задание ещё закрыто. Завершите предыдущие задания, чтобы открыть его.
        </MudAlert>
        <MudButton Class="mt-3" Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/profile/quests"))">
            К списку заданий
        </MudButton>
    </MudContainer>
}
else
{
    <MudContainer Class="mt-4" MaxWidth="MaxWidth.ExtraLarge">
        <div class="d-flex align-center mb-3">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Nav.NavigateTo("/profile/quests"))" />
            <MudText Typo="Typo.h5" Class="ml-2">@details.Name</MudText>
            <MudSpacer />
            <MudChip T="string" Color="@StatusColor(details.Status)" Variant="Variant.Outlined" Size="Size.Small">
                @details.Status
            </MudChip>
        </div>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 text-muted">ОПИСАНИЕ</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3">@details.Description</MudText>

                    <MudDivider Class="my-3" />

                    <MudText Typo="Typo.subtitle2" Class="mb-2 text-muted">ВОПРОС</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3 font-weight-medium">@details.Question</MudText>

                    @if (!string.IsNullOrWhiteSpace(details.ReviewComment))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">
                            Комментарий преподавателя: @details.ReviewComment
                        </MudAlert>
                    }

                    @if (details.Status == QuestStatus.PendingReview)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            Ваш ответ <b>@details.LastAnswer</b> отправлен преподавателю на проверку.
                        </MudAlert>
                    }
                    else if (details.Status == QuestStatus.Completed)
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3">
                            Задание выполнено и одобрено преподавателем.
                        </MudAlert>
                    }
                    else
                    {
                        <MudTextField @bind-Value="answer"
                                      Label="Ваш ответ"
                                      Variant="Variant.Outlined"
                                      Class="mb-3"
                                      OnKeyDown="OnAnswerKey" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="Submit">
                            Сдать ответ
                        </MudButton>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-3" Elevation="2">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="text-muted">ТЕРМИНАЛ ЗАДАНИЯ</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   Size="Size.Small"
                                   OnClick="ResetTerm">
                            Сбросить
                        </MudButton>
                    </div>

                    <div class="terminal" @onclick="FocusInput">
                        <div class="terminal-header">
                            <span class="dot dot-r"></span>
                            <span class="dot dot-y"></span>
                            <span class="dot dot-g"></span>
                            <span class="terminal-title">@login@@ubuntu — quest #@details.Order</span>
                        </div>
                        <div class="terminal-body">
                            @foreach (var line in output)
                            {
                                <div class="line @(line.Kind)">@line.Text</div>
                            }
                            <div class="line input-line">
                                <span class="prompt">@prompt</span>
                                <input class="cmd-input"
                                       @ref="inputRef"
                                       @bind="current"
                                       @bind:event="oninput"
                                       @onkeydown="OnTermKey"
                                       spellcheck="false"
                                       autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    [Parameter] public int QuestId { get; set; }

    private record Line(string Text, string Kind);

    private QuestProgressDetails? details;
    private List<Line> output = new();
    private List<string> history = new();
    private int historyIndex = -1;
    private string current = "";
    private string answer = "";
    private string prompt = "$ ";
    private string login = "";
    private string role = "";
    private int userId;
    private ElementReference inputRef;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        login = state.User.Identity?.Name ?? "user";
        role = state.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
        if (int.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            userId = id;

        details = await Progress.ForUserQuestAsync(userId, QuestId);
        if (details is null || details.Status == QuestStatus.Locked) return;

        if (details.Status == QuestStatus.NotStarted)
        {
            await Progress.SetStatusAsync(userId, QuestId, QuestStatus.InProgress);
            details = await Progress.ForUserQuestAsync(userId, QuestId);
        }

        var view = await Term.LoadAsync(userId, login, role, QuestId);
        prompt = view.Prompt;
        history = view.History.ToList();
        output.Add(new Line($"Песочница задания #{details!.Order}. Введите 'help' для списка команд, 'man <команда>' для справки.", "sys"));
    }

    private async Task OnTermKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteCmd();
        }
        else if (e.Key == "ArrowUp")
        {
            if (history.Count == 0) return;
            historyIndex = historyIndex < 0 ? history.Count - 1 : Math.Max(0, historyIndex - 1);
            current = history[historyIndex];
        }
        else if (e.Key == "ArrowDown")
        {
            if (history.Count == 0 || historyIndex < 0) return;
            historyIndex++;
            if (historyIndex >= history.Count) { historyIndex = -1; current = ""; }
            else current = history[historyIndex];
        }
    }

    private async Task ExecuteCmd()
    {
        var cmd = current;
        current = "";
        historyIndex = -1;
        output.Add(new Line(prompt + cmd, "cmd"));

        if (string.IsNullOrWhiteSpace(cmd)) return;

        var (text, view) = await Term.ExecuteAsync(userId, login, role, cmd, QuestId);
        prompt = view.Prompt;
        history = view.History.ToList();

        if (text == "CLEAR")
        {
            output.Clear();
        }
        else if (cmd.Trim() == "history")
        {
            for (int i = 0; i < history.Count; i++)
                output.Add(new Line($"  {i + 1}  {history[i]}", "out"));
        }
        else if (!string.IsNullOrEmpty(text))
        {
            foreach (var ln in text.Split('\n'))
                output.Add(new Line(ln.TrimEnd('\r'), "out"));
        }

        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await inputRef.FocusAsync();
    }

    private async Task FocusInput() => await inputRef.FocusAsync();

    private async Task ResetTerm()
    {
        await Term.ResetAsync(userId, QuestId);
        var view = await Term.LoadAsync(userId, login, role, QuestId);
        prompt = view.Prompt;
        history = view.History.ToList();
        output.Clear();
        output.Add(new Line("Терминал задания сброшен.", "sys"));
    }

    private async Task OnAnswerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(answer))
        {
            Snackbar.Add("Введите ответ", Severity.Warning);
            return;
        }
        var msg = await Progress.SubmitAnswerAsync(userId, QuestId, answer);
        details = await Progress.ForUserQuestAsync(userId, QuestId);
        var severity = details?.Status == QuestStatus.PendingReview ? Severity.Success : Severity.Info;
        Snackbar.Add(msg, severity);
        answer = "";
    }

    private static Color StatusColor(string status) => status switch
    {
        QuestStatus.Completed => Color.Success,
        QuestStatus.PendingReview => Color.Info,
        QuestStatus.InProgress => Color.Warning,
        QuestStatus.Locked => Color.Default,
        _ => Color.Primary
    };
}
