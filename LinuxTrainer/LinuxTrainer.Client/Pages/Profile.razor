@page "/profile"
@using MudBlazor
@using System.Linq

<PageTitle>Профиль</PageTitle>

<div class="d-flex" style="height: 100vh;">
    <!-- Основной контент -->
    <MudContainer Class="mt-4" MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.h5" Class="mb-4">Статистика профиля</MudText>
        
        <!-- Карточки статистики -->
        <MudGrid Spacing="4">
            <!-- Прогресс выполнения -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 d-flex align-center" Elevation="2">
                    <MudProgressCircular 
                        Value="@CompletionPercent" 
                        Size="@Size.Large"
                        Color="Color.Primary"
                        Class="mr-4" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Выполнено заданий</MudText>
                        <MudText Typo="Typo.body2" Class="text-muted">
                            @completedQuests из @totalQuests
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">
                            @CompletionPercent% прогресс
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 d-flex align-center" Elevation="2">
                    <div class="mr-4 d-flex align-center justify-center" style="width: 68px; height: 68px; border-radius: 50%; background-color: rgba(255, 193, 7, 0.15);">
                        <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Warning">@averageRating.ToString("0.0")</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Средний балл</MudText>
                        <MudText Typo="Typo.caption" Class="text-muted">
                            Оценено заданий: @ratedQuests из @stats.Count
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Таблица оценок и статусов -->
        <MudPaper Class="pa-4 mt-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Детализация</MudText>
            <MudTable T="StatItem" Items="@stats" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Категория</MudTh>
                    <MudTh>Балл</MudTh>
                    <MudTh>Статус</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Категория">@context.Category</MudTd>
                    
                    <MudTd DataLabel="Балл">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Rating.ToString("0.0") / 5.0</MudText>
                    </MudTd>
                    
                    <MudTd DataLabel="Статус">
                        <MudChip T="string" 
                                Color="@GetStatusColor(context.Status)" 
                                Size="Size.Small">
                            @context.Status
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private int totalQuests => stats.Count;
    private int completedQuests => stats.Count(s => s.Status == "Завершено");
    private double CompletionPercent => totalQuests > 0 
        ? Math.Round((double)completedQuests / totalQuests * 100) 
        : 0;

    private double completionPercent => totalQuests > 0 
        ? Math.Round((double)completedQuests / totalQuests * 100) 
        : 0;

    // Детальная статистика
    private List<StatItem> stats = new()
    {
        new StatItem { Category = "Основы Linux", Rating = 5.0, Status = "Завершено" },
        new StatItem { Category = "Работа с файлами", Rating = 4.5, Status = "Завершено" },
        new StatItem { Category = "Права доступа", Rating = 0.0, Status = "В процессе" },
        new StatItem { Category = "Настройка сети", Rating = 0.0, Status = "В процессе" },
        new StatItem { Category = "Bash скрипты", Rating = 0.0, Status = "Не начато" },
        new StatItem { Category = "Администрирование", Rating = 0.0, Status = "Недоступно" },
    };

    // === ФОРМУЛА РАСЧЁТА СРЕДНЕГО БАЛЛА ===
    // Берём только задания с оценкой > 0 и считаем среднее арифметическое
    private double averageRating => CalculateAverageRating();
    
    private double CalculateAverageRating()
    {
        var ratedItems = stats.Where(s => s.Rating > 0).ToList();
        if (!ratedItems.Any()) return 0;
        
        return Math.Round(ratedItems.Average(s => s.Rating), 1);
    }
    
    private int ratedQuests => stats.Count(s => s.Rating > 0);
    // =====================================

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Завершено" => Color.Success,
            "В процессе" => Color.Warning,
            "Не начато" => Color.Info,
            "Недоступно" => Color.Default,
            _ => Color.Default
        };
    }

    public class StatItem
    {
        public string Category { get; set; } = "";
        public double Rating { get; set; }
        public string Status { get; set; } = "";
    }
}